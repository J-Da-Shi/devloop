{
  "name": "@devloop/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "DEVLOOP_SEED=true tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@devloop/db": "workspace:*",
    "@devloop/git": "workspace:*",
    "@devloop/runners": "workspace:*",
    "@devloop/shared": "workspace:*",
    "@devloop/workflow": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.3",
    "fastify": "5.11.3",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.4.3"
  }
}

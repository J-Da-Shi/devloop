{
  "name": "devloop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "pnpm packages:build && concurrently -k -n server,web,desktop -c green,blue,magenta \"pnpm --filter @devloop/server dev\" \"pnpm --filter @devloop/web dev\" \"pnpm --filter @devloop/desktop dev\"",
    "dev:web": "pnpm packages:build && concurrently -k -n server,web -c green,blue \"pnpm --filter @devloop/server dev\" \"pnpm --filter @devloop/web dev\"",
    "packages:build": "pnpm --filter './packages/**' build",
    "build": "pnpm -r build",
    "typecheck": "pnpm packages:build && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "10.0.4",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.9.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "fs-xattr",
      "macos-alias"
    ]
  }
}

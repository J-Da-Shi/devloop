{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devloop.local/schemas/agent-result.v1.schema.json",
  "title": "DevLoop Agent Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary", "acceptanceCriteria", "risks"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["succeeded", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_verifiable"]
          },
          "evidence": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockedReason": {
      "type": ["string", "null"]
    },
    "preview": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["command", "workingDirectory", "healthPath"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "allOf": [{ "pattern": "\\{\\{port\\}\\}" }, { "pattern": "127\\.0\\.0\\.1" }]
        },
        "workingDirectory": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "healthPath": { "type": "string", "pattern": "^/(?!/)" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devloop.local/schemas/agent-result.v1.schema.json",
  "title": "DevLoop Agent Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary", "acceptanceCriteria", "risks"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["succeeded", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_verifiable"]
          },
          "evidence": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockedReason": {
      "type": ["string", "null"]
    },
    "preview": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["command", "workingDirectory", "healthPath"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "allOf": [{ "pattern": "\\{\\{port\\}\\}" }, { "pattern": "127\\.0\\.0\\.1" }]
        },
        "workingDirectory": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "healthPath": { "type": "string", "pattern": "^/(?!/)" }
      }
    },
    "plan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["summary", "steps", "acceptanceCriteria", "assumptions", "risks"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "files", "verification"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "description": { "type": "string", "minLength": 1 },
              "files": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "verification": { "type": "string", "minLength": 1 }
            }
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "summary", "criteria", "checks", "issues"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
        "summary": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "status", "evidence"],
            "properties": {
              "criterion": { "type": "string", "minLength": 1 },
              "status": {
                "type": "string",
                "enum": ["passed", "failed", "not_verifiable"]
              },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "status", "evidence"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["passed", "failed", "not_run"] },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

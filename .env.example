# Docker Compose 部署配置。复制为 .env 后由 docker compose 读取。

# DevLoop 映射到宿主机的端口；只绑定 127.0.0.1，容器内端口固定为 4317。
DEVLOOP_PORT=4317

# 项目未指定执行器时使用的兜底执行器；可选 codex 或 fake。
DEVLOOP_RUNNER=codex

# 是否让 Codex CLI 忽略用户 config.toml 和规则文件；true 适合隔离部署环境。
DEVLOOP_CODEX_IGNORE_USER_CONFIG=false

# Codex 连续无输出多久后判定为卡住并终止，单位毫秒；不是任务总执行时限。
DEVLOOP_CODEX_STALL_TIMEOUT_MS=1800000

# 任务进入待执行状态后，Worker 至少等待多久再领取，单位毫秒。
DEVLOOP_AGENT_CLAIM_DELAY_MS=5000

# 服务日志级别，传给 Fastify/Pino，例如 trace、debug、info、warn、error。
DEVLOOP_LOG_LEVEL=info

# 自动预览启动后等待健康检查通过的最长时间，单位毫秒。
DEVLOOP_PREVIEW_STARTUP_TIMEOUT_MS=90000

# 在隔离预览 Worktree 中按锁文件安装依赖的最长时间，单位毫秒。
DEVLOOP_PREVIEW_DEPENDENCY_INSTALL_TIMEOUT_MS=600000

# Playwright 页面加载、截图和基础检查的超时时间，单位毫秒。
DEVLOOP_PLAYWRIGHT_TIMEOUT_MS=60000

# 项目自定义 Playwright 命令的最长执行时间，单位毫秒。
DEVLOOP_PLAYWRIGHT_TEST_TIMEOUT_MS=600000

# 可选：指定已有的 Chromium/Chrome/Edge 可执行文件。
DEVLOOP_PLAYWRIGHT_EXECUTABLE=

# Docker 镜像构建时安装的 @openai/codex npm 包版本。
CODEX_CLI_VERSION=0.145.0

# 宿主机上的 Codex 配置目录，以可写方式挂载到容器的 /home/devloop/.codex。
DEVLOOP_CODEX_DIR=./config/codex

# 宿主机上的 SSH 配置目录，以只读方式挂载，供 Git 拉取和推送私有仓库。
DEVLOOP_SSH_DIR=./config/ssh

# OpenAI API Key；Codex 已通过挂载配置登录时留空。
OPENAI_API_KEY=

# Codex CLI 使用的独立 API Key；只有当前 Codex 配置依赖它时才填写。
CODEX_API_KEY=

# HTTP 请求使用的代理地址；不需要代理时留空。
HTTP_PROXY=

# HTTPS 请求使用的代理地址；不需要代理时留空。
HTTPS_PROXY=

# 不经过代理的主机列表；默认保留本机地址和 Compose 服务名。
NO_PROXY=127.0.0.1,localhost,devloop
